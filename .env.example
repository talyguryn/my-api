# Server Configuration
PORT=3000
NODE_ENV=development

# API Keys and Tokens
API_BEARER_TOKEN=your_secret_bearer_token_here

# Cache Configuration
# Options: memory (default), redis, memcache
CACHE_DRIVER=memory
CACHE_TTL=3600

# Redis Configuration (optional, if CACHE_DRIVER=redis)
REDIS_URL=redis://localhost:6379

# Memcache Configuration (optional, if CACHE_DRIVER=memcache)
MEMCACHE_SERVERS=localhost:11211

# Logging
LOG_LEVEL=debug
